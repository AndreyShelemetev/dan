# PostgreSQL
POSTGRES_DB=pamyat_ryadom
POSTGRES_USER=pamyat_ryadom_user
POSTGRES_PASSWORD=change_me
# Non-default port so this stack can run alongside other local Postgres instances
# (e.g. the sibling NaidiAI project, which uses 5432).
POSTGRES_PORT=5442

# Backend API
API_PORT=5100
ASPNETCORE_ENVIRONMENT=Development
# Frontend origin(s) allowed by CORS (comma-separated). See Program.cs.
FRONTEND_ORIGIN=http://localhost:3100

# Frontend (Next.js)
FRONTEND_PORT=3100
# Browser-facing URLs baked into the client bundle at build time.
# PRODUCTION: set these to the public domain served by nginx, e.g.
#   PUBLIC_API_URL=https://pamyat-ryadom.ru/api/v1
#   PUBLIC_SITE_URL=https://pamyat-ryadom.ru
PUBLIC_API_URL=http://localhost:5100/api/v1
PUBLIC_SITE_URL=http://localhost:3100

# Adminer (dev only)
ADMINER_PORT=8090

# -----------------------------------------------------------------------------
# The sections below are placeholders only — nothing in the current codebase
# reads them yet. Each is wired up by the module task that needs it; until then
# they document the shape a later task should follow.
# -----------------------------------------------------------------------------

# SMTP (passwordless login codes / notifications) — added by a later task.
# SMTP_ENABLED=false
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Память рядом

# YooKassa (ЮKassa) payments — added by a later task.
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET_KEY=
# YOOKASSA_RETURN_URL=

# Private S3-compatible object storage for photographs.
# In dev these defaults point at the MinIO container from docker-compose.override.yml.
# In production they must point at a bucket in a Russian region, with public reads disabled:
# grave photos and coordinates are personal data under the localisation rule.
S3_ENDPOINT=http://minio:9000
# The address presigned links are signed for — the one a browser can reach. It differs from
# S3_ENDPOINT in dev, and the host is part of the signature, so it cannot be rewritten later.
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_BUCKET=pamyat-media
S3_ACCESS_KEY=pamyat_minio
S3_SECRET_KEY=change_me_minio
S3_REGION=ru-central1
S3_USE_PATH_STYLE=true

# MinIO (dev only): 9100 is the S3 API the browser uploads to, 9101 the web console.
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

# ASP.NET Data Protection key ring (encrypts stored MFA secrets).
# Must point at persistent storage — docker-compose.yml mounts the
# `dataprotection_keys` volume here. Losing it forces every user to re-enrol MFA.
DataProtection__KeyRingPath=/var/lib/pamyat-ryadom/dataprotection-keys
